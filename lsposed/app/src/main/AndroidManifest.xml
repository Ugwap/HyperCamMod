<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:icon="@android:drawable/ic_menu_camera"
        android:label="@string/app_name"
        android:theme="@style/Theme.HyperCamMod">

        <!-- Penanda modul untuk LSPosed -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="@string/xposed_description" />
        <meta-data
            android:name="xposedminversion"
            android:value="82" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <!--
                LSPosed Manager membuka layar modul lewat ACTION_MAIN +
                category MODULE_SETTINGS. Filter ini tidak membuat ikon
                launcher, jadi tetap bisa dibuka walau ikon disembunyikan.
            -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
            </intent-filter>
        </activity>

        <!--
            Ikon launcher dipisah ke alias supaya bisa di-enable/disable dari
            MainActivity tanpa mematikan modul. Kalau alias di-disable, ikon
            hilang dari home screen tapi LSPosed tetap memuat modul.
        -->
        <activity-alias
            android:name=".Launcher"
            android:enabled="true"
            android:exported="true"
            android:icon="@android:drawable/ic_menu_camera"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>

</manifest>
